APP_NAME=Sapio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# DATABASE — PostgreSQL (dev locale) o SQLite per test rapidi
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sapio
DB_USERNAME=sapio
DB_PASSWORD=

# ---------------------------------------------------------------------------
# SESSION — dominio con punto per tenant su sottodomini (es. .sapio.app)
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1

# ---------------------------------------------------------------------------
# QUEUE / CACHE — Redis per produzione, database per dev
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# AI — OpenAI (GPT + Embeddings)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# EMAIL
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sapio.app"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# STORAGE S3 (opzionale — per PDF/DOCX in produzione)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# SAAS-CORE (passkey, mobile, tenant)
# ---------------------------------------------------------------------------
WEBAUTHN_ALLOWED_ORIGINS=
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=
IOS_APP_ID=

# ---------------------------------------------------------------------------
# EMAIL INTEGRATION (Gmail / Outlook — Modulo 4)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# KNOWLEDGE BASE / GEMINI
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
KNOWLEDGE_EMBEDDING_PROVIDER=baai
KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-2
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_EMBEDDING_BATCH_SIZE=
KNOWLEDGE_BAAI_ENDPOINT=http://127.0.0.1:8765/embed
KNOWLEDGE_BAAI_MODEL=BAAI/bge-m3
KNOWLEDGE_BAAI_BATCH_SIZE=8
KNOWLEDGE_BAAI_TIMEOUT=900
KNOWLEDGE_MODEL_SIMPLE=gemma-4-26b
KNOWLEDGE_MODEL_COMPLEX=gemma-4-31b

# ---------------------------------------------------------------------------
# BILLING / STRIPE (Cashier) — il tenant (azienda) è l'entità che si abbona
# ---------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=eur
# Posti (utenti max) per piano
SAAS_SEATS_FREE=1
SAAS_SEATS_PRO=10
SAAS_SEATS_ENTERPRISE=50
# Stripe Price ID dei piani a pagamento
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# Mancato pagamento/scadenza: 'suspend' | 'downgrade'
SAAS_BILLING_PAST_DUE=suspend

VITE_APP_NAME="${APP_NAME}"
